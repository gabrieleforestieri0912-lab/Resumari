# ─────────────────────────────────────────────────────────────
# Resumari — variabili d'ambiente
# Copiare in `.env.local` (sviluppo) e impostare in Vercel (produzione):
#   cp .env.example .env.local
# Nessun valore reale va committato: `.env*` è in .gitignore (tranne questo file).
# ─────────────────────────────────────────────────────────────

# --- Supabase (obbligatorio: senza DB l'app non ha login, crediti né API key) ---
# Project Settings → API. `SUPABASE_SERVICE_ROLE_KEY` deve avere il claim
# role=service_role: con la anon key le scritture falliscono (RLS).
# Verificabile da /api/health (campi supabase_host e supabase_key_role).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Deve combaciare con il dominio reale: se l'issuer OAuth non coincide con
# l'host i client MCP rifiutano la configurazione.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Segreti lunghi e casuali, diversi tra loro e da quelli di produzione.
NEXTAUTH_SECRET=
JWT_SECRET=

# --- Pagamenti (Stripe) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (xKiro / OpenAI-compatible) ---
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.dev/v1
XKIRO_MODEL=
XKIRO_VISION_MODEL=
# Opzionale: solo per trascrizione audio Whisper (xKiro non offre STT).
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=

# --- YouTube ---
# Senza questa chiave funzionano solo i fallback di sottotitoli.
YOUTUBE_API_KEY=

# --- OAuth Google (login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Obbligatoria in produzione: senza questa il codice usa un indirizzo personale.
SUPPORT_EMAIL=

# --- MCP (opzionale) ---
# Callback OAuth consentiti oltre a loopback e al dominio dell'app, separati da
# virgole. Esempio: https://esempio.com/oauth/callback
MCP_OAUTH_REDIRECT_URIS=
